64,iVBORw0KGgoAAAANSUhEUgAAAAgAAAAECAYAAACzzX7wAAAASElEQVR42lWN0QqAUAhD75s6pbL+/1tXEwp6ODB2hi4zo7szIh5Az5oMYFiSmcnuJs6LsR8jNJKbgYqsIraarE7o+vq/iE+83P42I2mrrzTnAAAAAElFTkSuQmCC"},H={src:e.i(604487).default,width:1280,height:596,blurWidth:8,blurHeight:4,blurDataURL:"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAgAAAAECAYAAACzzX7wAAAAR0lEQVR42k2NUQ7AIAhDvf9xFZGCSRfYSPbxQqFQxr3BxB2McAKvBqzqSNPscK3JKeBW/0yrw1rIgZ5NUSmdSZ08/i+S7psHU+p9fTr9OrgAAAAASUVORK5CYII="},$=[{id:"gemma-4",title:"Gemma 4 now on LiveKit Inference",description:"A faster, cheaper default for voice agents. Optimized for speed, but smart enough for any production task. Tested against GPT 4.1, Gemma produced the same answer quality and task performance at 5.2x lower latency, and 6x lower cost.",date:"2026-07-07",imageLight:Q,imageDark:P,tileImageLight:m,tileImageDark:g,tileMessage:(0,t.jsxs)(t.Fragment,{children:["Gemma 4 now on",(0,t.jsx)("br",{}),"LiveKit Inference"]}),primaryCta:{label:"Use in Agent Builder",href:e=>(0,i.agentBuilderNewPath)(e,{llm:"google/gemma-4-31b-it"})},secondaryCta:{label:"View docs",href:"https://docs.livekit.io/agents/models/llm/livekit/"}},{id:"turn-detector",title:"Introducing LiveKit Turn Detector v1",description:"Our latest turn detection model listens to speech directly instead of waiting for a transcript, fusing semantic and acoustic understanding into a single end-of-turn prediction. The result is the strongest accuracy of any model we tested, across English and 13 other languages. Use v1 with any agent deployed to LiveKit Cloud, or deploy v1-mini, tuned for fast CPU inference and bundled with LiveKit Agents Python 1.6.1 and TypeScript 1.4.7.",date:"2026-06-17",imageLight:_,imageDark:T,tileImageLight:x,tileImageDark:R,tileMessage:"Turn Detector v1",primaryCta:{label:"View docs",href:"https://docs.livekit.io/agents/logic/turns/turn-detector/?utm_source=product&utm_medium=modal"},secondaryCta:{label:"Learn more",href:"https://livekit.com/blog/solving-end-of-turn-detection?utm_source=product&utm_medium=modal"}},{id:"embed-widget",title:"Embed voice agents on any website",description:"Add a LiveKit voice agent to any web page or app with a single <script> tag. Pass per-session identity and metadata so the agent already knows who it's talking to. The widget renders with your custom branding and can expand to include video, screen share, and text chat.",date:"2026-05-19",imageLight:Z,imageDark:J,tileImageLight:v,tileImageDark:f,tileMessage:(0,t.jsxs)(t.Fragment,{children:["Embeddable",(0,t.jsx)("br",{}),"agents"]}),primaryCta:{label:"Learn more",href:"https://livekit.com/blog/ship-voice-agent-on-any-website-script-tag?utm_source=product&utm_medium=modal"}},{id:"amd",title:"Answering machine detection",description:"Route outbound calls intelligently with answering machine detection. Your agents can now classify who picks up the phone (human, voicemail, IVR, or unavailable line) and decide whether to hold a conversation, leave a message, navigate a menu, or hang up.",date:"2026-05-13",imageLight:N,imageDark:j,tileImageLight:o,tileImageDark:n,tileMessage:(0,t.jsxs)(t.Fragment,{children:["Answering machine",(0,t.jsx)("br",{}),"detection"]}),primaryCta:{label:"View docs",href:"https://docs.livekit.io/telephony/features/answering-machine-detection?utm_source=product&utm_medium=modal"},secondaryCta:{label:"Learn more",href:"https://livekit.com/blog/answering-machine-detection?utm_source=product&utm_medium=modal"}},{id:"custom-voices",title:"Introducing custom voices with LiveKit Inference",description:"Create custom voices for your agents using an audio sample or recording across multiple TTS providers.",date:"2026-05-06",imageLight:H,imageDark:q,tileImageLight:E,tileImageDark:S,tileMessage:"Custom voices",primaryCta:{label:"Try it out",href:e=>(0,i.voicesPath)(e)},secondaryCta:{label:"Learn more",href:"https://docs.livekit.io/agents/multimodality/audio/custom-voices/?utm_source=product&utm_medium=modal"}},{id:"data-collection",title:"Collect structured data with voice agents",description:"Gather user information reliably with LiveKit Agents. Data collection mode lets you define fields, guide a voice or chat agent through them, and submit a JSON payload to your endpoint when the session ends. Available in Agent Builder, or as Tasks and TaskGroups in the Agents SDKs.",date:"2026-04-29",imageLight:D,imageDark:L,tileImageLight:b,tileImageDark:p,tileMessage:"Data collection",primaryCta:{label:"Learn more",href:"https://docs.livekit.io/agents/logic/tasks/?utm_source=product&utm_medium=modal"}},{id:"console",title:"Agent Console",description:"Debug your voice agents in real time. Agent Console gives you a live view of your session across audio, events, latency, tool calls, transcripts, session and participant state, RPC traffic, DTMF, and usage. Available for Python and Node agents, Agent Builder, and live sessions.",date:"2026-04-14",imageLight:G,imageDark:Y,tileImageLight:c,tileImageDark:d,tileMessage:"Agent Console",primaryCta:{label:"Try it out",href:e=>(0,i.consolePath)(e)},secondaryCta:{label:"Learn more",href:"https://docs.livekit.io/agents/start/console?utm_source=product&utm_medium=modal"}},{id:"barge-in",title:"Adaptive interruption handling",description:'We trained a new audio-based model to distinguish true vs false human interruptions, such as coughing, laughter, and short backchannels (e.g., "mm-hmm"), so your agents can respond more naturally in conversations.',date:"2026-03-19",imageLight:W,imageDark:B,tileImageLight:s,tileImageDark:l,tileMessage:"Adaptive interruption handling",primaryCta:{label:"Learn more",href:"https://livekit.com/blog/adaptive-interruption-handling?utm_source=product&utm_medium=modal"}},{id:"agents-ui",title:"Introducing Agents UI",description:"Try LiveKit's open source component library for production-ready, fully customizable voice agent interfaces, built on React and shadcn.",date:"2026-03-03",imageLight:I,imageDark:k,tileImageLight:r,tileImageDark:a,tileMessage:"Agents UI",primaryCta:{label:"Learn more",href:"https://blog.livekit.io/design-voice-ai-interfaces-with-agents-ui/"}},{id:"devday",title:"What’s new from LiveKit DevDay",description:"We just launched three new exciting additions to our platform to make it easier than ever to build voice agents on LiveKit. Introducing Agent Builder, Phone Numbers, and Agent Observability to help you build, connect, and monitor your agents.",date:"2025-11-19",imageLight:z,imageDark:M,tileImageLight:y,tileImageDark:A,tileMessage:"LiveKit DevDay",primaryCta:{label:"See all announcements",href:"https://livekit.io/events/dev-day?utm_source=virtual&utm_medium=in_app&utm_campaign=nov_25"}},{id:"light-mode",title:"Brighten up your dashboard",description:"Light mode is now available in LiveKit Cloud. Whether you prefer a brighter workspace or just need a break from the dark, you can switch themes anytime in User settings.",date:"2025-10-13",imageLight:K,imageDark:F,tileMessage:"Light mode"},{id:"inference",title:"LiveKit Inference",description:"Build voice agents that call the most popular AI models with a single API key. LiveKit's inference service offers easy access to the best STT, LLM, and TTS models available in the market. Swap models with a simple code update, no new API keys required. Manage usage with LiveKit Cloud, including consolidated billing, rate limit management, and usage reporting.",date:"2025-10-01",imageLight:O,imageDark:X,tileImageLight:C,tileImageDark:h,tileMessage:"LiveKit Inference",primaryCta:{label:"View documentation",href:"https://docs.livekit.io/agents/models/"}},{id:"agents",title:"Run your AI voice and video agents on LiveKit Cloud",description:"LiveKit Cloud takes care of the full agent lifecycle, from deployment to scaling to serving at the edge, and offers detailed observability and analytics.",date:"2025-08-08",imageLight:V,imageDark:U,tileImageLight:w,tileImageDark:u,tileMessage:"LiveKit Agents",primaryCta:{label:"Go to Agents",href:e=>(0,i.agentsPath)(e)}}];e.s(